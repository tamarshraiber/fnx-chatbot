GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Project URL only, like https://abcdefgh.supabase.co (no /rest/v1 at the end).
SUPABASE_URL=
# The service_role (secret) key. Keep it only in .env.
SUPABASE_KEY=

# Backup LLMs (step 16). Order: Gemini, then Groq, then OpenRouter. Providers with no key are skipped.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Safeguards (step 16b). Optional, these are the defaults.
MAX_QUESTION_CHARS=500
MAX_HISTORY_ITEMS=20
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Cohere Rerank (step 15). Free trial key from dashboard.cohere.com.
COHERE_API_KEY=
